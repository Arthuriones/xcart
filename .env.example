# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: used by Vercel Cron as Authorization: Bearer $CRON_SECRET
CRON_SECRET=change-me
# Optional: global fallback proxy for product import fetches in production
# Example template with placeholder: https://your-proxy.example/scrape?url={url}
IMPORT_FETCH_PROXY_URL=
GLOBAL_FETCH_PROXY_URL=
# Optional: legacy fallback proxy for AliExpress fetch in production
# Example template with placeholder: https://your-proxy.example/scrape?url={url}
ALIEXPRESS_FETCH_PROXY_URL=
# Optional: Bright Data direct fallback (Web Unlocker API)
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=
BRIGHTDATA_COUNTRY=br
# Optional: Bright Data native proxy fallback
BRIGHTDATA_PROXY_HOST=brd.superproxy.io
BRIGHTDATA_PROXY_PORT=33335
BRIGHTDATA_PROXY_USERNAME=
BRIGHTDATA_PROXY_PASSWORD=
BRIGHTDATA_PROXY_INSECURE_TLS=true

# Shopify (credenciais ficam no Supabase por loja)

# Meta / Instagram
# facebook = API setup with Facebook login (Pagina vinculada ao Instagram).
# instagram = API setup with Instagram login.
INSTAGRAM_AUTH_MODE=facebook
# Prefer these when using Instagram API with Instagram Login.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
# Optional: paste the exact Embed URL from Meta > Instagram > API setup with
# Instagram login > Set up Instagram business login. Leave empty to build it.
INSTAGRAM_EMBED_URL=
# Optional: configuration ID shown in Meta's Instagram business login settings.
INSTAGRAM_CONFIG_ID=
# Backward-compatible fallback for older Meta/Facebook Login integrations.
META_APP_ID=
META_APP_SECRET=
# Optional: keep aligned with Meta docs when upgrading Graph API versions.
META_GRAPH_VERSION=v24.0

# Stripe (obrigatorio para billing — estavam faltando neste arquivo)

# Flags de cobranca/acesso. Ambas default OFF: o sistema so MEDE uso ate serem
# ligadas. BILLING_ENFORCED=true passa a debitar creditos;
# ACCESS_CONTROL_ENABLED=true liga a trava de entrada + trial de 1 clonagem.
BILLING_ENFORCED=false
ACCESS_CONTROL_ENABLED=false

# Alternativa ao CRON_SECRET para o worker de importacao em massa
BULK_IMPORT_CRON_SECRET=

# Pagou.ai (cobranca) — https://developer.pagou.ai
PAGOU_SECRET_KEY=sk_live_ou_sk_test
PAGOU_API_URL=https://api.pagou.ai
# Segredo que vai na notify_url; o webhook rejeita chamada sem ele.
PAGOU_WEBHOOK_TOKEN=gere-uma-string-aleatoria-longa
# Security Token do webhook cadastrado no painel (Configuracoes -> Integracoes).
# Confere o HMAC de X-Pagou-Signature; a notify_url continua no token acima.
PAGOU_WEBHOOK_SECRET=
NEXT_PUBLIC_PAGOU_PUBLIC_KEY=pk_test_sua_chave_publica
NEXT_PUBLIC_PAGOU_ENV=sandbox
# Cambio usado so no painel admin, para comparar receita BRL com custo USD.
USD_BRL_RATE=5.4

# LEGADO: manter enquanto houver assinatura Stripe ativa (ver payment_provider).
STRIPE_WEBHOOK_SECRET=
