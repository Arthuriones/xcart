{
  "regions": ["cle1"],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)scripts/'",
  "functions": {
    "src/app/api/aliexpress/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "src/app/api/jobs/bulk-import/process/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/jobs/routes/heal/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/checkout-routes/repair/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/checkout-routes/connect-by-sku/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/jobs/tracking/drain/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/jobs/ads/regras/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/jobs/bulk-import/process",
      "schedule": "57 * * * *"
    },
    {
      "path": "/api/jobs/routes/heal",
      "schedule": "25 * * * *"
    },
    {
      "path": "/api/jobs/tracking/drain",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/jobs/financeiro/pedidos",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/jobs/ads/meta",
      "schedule": "5,20,35,50 * * * *"
    },
    {
      "path": "/api/jobs/ads/regras",
      "schedule": "10,25,40,55 * * * *"
    },
    {
      "path": "/api/jobs/financeiro/cambio",
      "schedule": "20 */6 * * *"
    },
    {
      "path": "/api/jobs/alertas",
      "schedule": "3,13,23,33,43,53 * * * *"
    },
    {
      "path": "/api/jobs/demonstracao",
      "schedule": "7,22,37,52 * * * *"
    }
  ]
}
